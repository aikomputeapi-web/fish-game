# ---- Server ----
PORT=3000
# If set, uses Postgres (pg). If empty, uses a local SQLite file (dev.sqlite).
DATABASE_URL=
JWT_SECRET=change-this-to-a-long-random-string
# Comma-separated browser origins permitted to open authenticated Socket.IO connections.
# Defaults to APP_URL when omitted.
ALLOWED_ORIGINS=http://localhost:3000

# Owner account seeded on first boot
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-first-boot

# Player signup bonus (virtual points, no real money)
SIGNUP_BONUS=2000

# ---- Email verification (sign-ups) ----
# Public URL used in verification links (e.g. https://your-app.onrender.com)
APP_URL=http://localhost:3000
# SMTP settings. Leave SMTP_HOST empty in dev: verification links are logged
# to the server console instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Fire Kirin <no-reply@example.com>
